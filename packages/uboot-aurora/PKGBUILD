pkgname=uboot-aurora
pkgver=2026.07.aurora11
pkgrel=1
pkgdesc='Aurora common Apple Silicon U-Boot with Neo MTP handoff'
arch=('aarch64')
groups=('aurora-platform-apple-silicon')
url='https://github.com/aurora-silicon/u-boot'
license=('GPL-2.0-or-later')
_commit=250385f8c8aaafd47a8f7990f6efe0443c28d0b5
provides=("uboot-asahi=$pkgver")
conflicts=('uboot-asahi' 'uboot-asahi-j700')
replaces=('uboot-asahi-j700')
makedepends=('git' 'bc' 'dtc' 'python' 'python-pyelftools' 'swig' 'openssl')
options=('!strip' '!debug')
# OpenSSL 4 removed the ENGINE API that U-Boot's host image tools (mkimage,
# dumpimage, fit_info) call, and they fail to link. Arch's uboot-tools carries
# this guard since 2026.07-3; drop it when U-Boot moves to the provider API.
source=("u-boot::git+$url.git#commit=$_commit"
        0001-rsa-guard-engine-support-when-unavailable-in-OpenSSL.patch)
sha256sums=('SKIP'
            '32515605485039e1b5f7dbfbf7d6cec2cca5bad3a7360d74b366d60683141108')
prepare() {
  cd u-boot
  patch -Np1 -i ../0001-rsa-guard-engine-support-when-unavailable-in-OpenSSL.patch
}
build() {
  cd u-boot
  make O=build-aurora CROSS_COMPILE="${CROSS_COMPILE:-}" PYTHON3=/usr/bin/python3 apple_m1_defconfig
  make O=build-aurora CROSS_COMPILE="${CROSS_COMPILE:-}" PYTHON3=/usr/bin/python3 -j"${OMARCHY_BUILD_JOBS:-10}"
}
package() {
  # A new U-Boot reaches Stage 2 through the updater's aura-try trial.
  depends=('aurora-stage2-trial')
  install -Dm644 u-boot/build-aurora/u-boot-nodtb.bin "$pkgdir/usr/lib/asahi-boot/u-boot-nodtb.bin"
  install -d "$pkgdir/usr/lib/asahi-boot-j700"
  ln -s ../asahi-boot/u-boot-nodtb.bin "$pkgdir/usr/lib/asahi-boot-j700/u-boot-nodtb.bin"
  install -Dm644 u-boot/Licenses/gpl-2.0.txt "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  # DTBs come from linux-aurora; generated u-boot.dtb is the default J274 tree.
}
